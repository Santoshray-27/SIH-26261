# ───────── Dependencies ─────────
node_modules/
.pnp
.pnp.js
.yarn/
.pnpm-store/

# ───────── Build output ─────────
dist/
dist-ssr/
build/
.vite/
.cache/
.parcel-cache/
.turbo/
*.local

# ───────── Environment & secrets (NEVER commit) ─────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# ───────── Logs ─────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ───────── Testing, audit & coverage ─────────
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
playwright/.cache/
audit-screenshots/
lighthouse-reports/
*.lighthouse.json

# ───────── TypeScript / tooling caches ─────────
*.tsbuildinfo
.eslintcache
.stylelintcache

# ───────── Editor / IDE ─────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ───────── OS files ─────────
.DS_Store
Thumbs.db
Desktop.ini

# ───────── Antigravity / AI tooling (local state only) ─────────
.gemini/
.antigravity/
.agent/cache/
.agent/tmp/
# NOTE: .agent/rules/ and .agent/workflows/ are intentionally NOT ignored (commit them)

# ───────── Backend (Python / FastAPI — for later) ─────────
